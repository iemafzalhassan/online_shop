# Stage 1: Build Stage
FROM node:22 AS build
# Set the working directory
WORKDIR /app
# Copy the packages to the directory /app
COPY package.json package-lock.json /app/
# Install the necessary dependcies
RUN npm install
# Copy the code form host to container
COPY . .
# build the packages
RUN npm run build
# Stage 2: Production Stage
FROM node:22-slim
# set the working directory
WORKDIR /app
# Copy build files
COPY --from=build /app/dist /app/dist
# Copy node_modules for the production stage
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/package-lock.json /app/
# Expose the port 
EXPOSE 5173
CMD ["npm", "run", "dev"]
