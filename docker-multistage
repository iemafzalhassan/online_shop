#stage 1
#create a base image (os)

FROM node:18-slim As builder 

#create a working directory

WORKDIR /app

#copy the source code from host to container

COPY . .

#install packages

RUN npm install

#stage 2

#create a base image (os)

FROM node:18-slim 

#create a working directory

WORKDIR /app

#copy the content from builder 

COPY --from=builder /app /app

#expose the posrt number 

EXPOSE 5173

#serve the app and keep it running

CMD ["npm","run","dev"]
